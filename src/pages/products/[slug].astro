---
import Layout from '../../components/templates/Layout.astro'
import { LinkButton } from '../../components/atoms/LinkButton'
import { ProductCard } from '../../components/molecules/ProductCard'
import { products } from '../../data/products'
import { productDetails } from '../../data/product-details'
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }))
}
const { product } = Astro.props
const details = productDetails[product.slug]
---

<Layout title={`${product.name} — ${product.category} | Minimal Tools`} description={product.description}>
  <main id="main" class="product-page" style={`--accent: ${product.color}`}>
    <section class="product-hero">
      <a class="text-link" href="/#products">
        ← Back to the toolbox
      </a>
      <div class="product-heading">
        <div>
          <p class="eyebrow">
            {product.name} / {product.category}
          </p>
          <h1>
            {product.headline.split('\n')[0]}
            <br />
            <span class="serif">{product.headline.split('\n')[1]}</span>
          </h1>
          <p class="hero-description">{details.summary}</p>
          <div class="hero-actions">
            <LinkButton icon="download" href={`https://github.com/mnml-tools/${product.slug}/releases`}>
              View releases
            </LinkButton>
            <LinkButton secondary href={`https://github.com/mnml-tools/${product.slug}`}>
              Explore the source
            </LinkButton>
          </div>
        </div>
        <img
          class="product-hero-icon"
          src={`/images/${product.slug}-icon.png`}
          alt={`${product.name} logo`}
          width="280"
          height="280"
        />
      </div>
      {product.slug === 'piw' && (
        <p class="release-note">
          Piw is pre-release. Tested daily on Linux / KDE Plasma. macOS and Windows builds have not yet been tested by
          hand.
        </p>
      )}
      <div class="full-screenshot">
        <img
          src={`/images/${product.slug}-light.png`}
          alt={`${product.name} desktop app in light mode`}
          width={product.slug === 'bud' ? 2828 : 1600}
          height={product.slug === 'bud' ? 2044 : 1000}
          fetchpriority="high"
        />
      </div>
    </section>
    <section class="feature-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Capabilities</p>
          <h2>
            How it <span class="serif">works.</span>
          </h2>
        </div>
        <a class="text-link" href={`https://github.com/mnml-tools/${product.slug}#readme`}>
          Read the documentation
        </a>
      </div>
      <div class="feature-grid">
        {details.features.map(({ title, description, capabilities }, index) => (
          <article>
            <span class="eyebrow">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
            <ul class="capability-list">
              {capabilities.map((capability) => (
                <li>{capability}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
    <section class="technical-section" aria-labelledby="technical-heading">
      <p class="eyebrow">Technical reference</p>
      <h2 id="technical-heading">
        Runtime &amp; <span class="serif">workflow.</span>
      </h2>
      <dl class="runtime-details">
        {details.runtime.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <div class="technical-columns">
        <div>
          <h3>Keyboard shortcuts</h3>
          <p class="reference-note">Use Ctrl on Linux and Windows; ⌘ on macOS unless shown otherwise.</p>
          <dl class="shortcut-list">
            {details.shortcuts.map(([keys, action]) => (
              <div>
                <dt>
                  <kbd>{keys}</kbd>
                </dt>
                <dd>{action}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <h3>Current limits &amp; behavior</h3>
          <ul class="capability-list">
            {details.limitations.map((limit) => (
              <li>{limit}</li>
            ))}
          </ul>
          <a
            class="text-link docs-link"
            href={`https://github.com/mnml-tools/${product.slug}/blob/main/docs/architecture.md`}
          >
            Architecture and implementation details
          </a>
        </div>
      </div>
    </section>
    <section class="dark-preview">
      <div>
        <p class="eyebrow">A different light</p>
        <h2>
          Find your <span class="serif">focus.</span>
        </h2>
        <p>A familiar workspace, in light or dark.</p>
      </div>
      <img
        src={`/images/${product.slug}-dark.png`}
        alt={`${product.name} desktop app in dark mode`}
        width={product.slug === 'bud' ? 2828 : 1600}
        height={product.slug === 'bud' ? 2044 : 1000}
        loading="lazy"
      />
    </section>
    <section class="related">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The rest of the family</p>
          <h2>
            Meet your other <span class="serif">tools.</span>
          </h2>
        </div>
      </div>
      <div class="product-grid related-grid">
        {products
          .filter((p) => p.slug !== product.slug)
          .map((p, i) => (
            <ProductCard product={p} index={i} />
          ))}
      </div>
    </section>
  </main>
</Layout>
